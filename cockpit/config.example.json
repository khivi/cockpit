{
  "repos": [
    {
      "name": "myrepo",
      "path": "/absolute/path/to/main/repo",
      "branch_prefix": "yourusername/",
      "default_base": "main",
      "sidebar_color": "Blue",
      "review_prs": false,
      "skills": {
        "review": "/pr-review"
      },
      "review_external": false,
      "dependabot": false,
      "update_stale_branches": false,
      "update_branch_method": "rebase",
      "tickets": {
        "provider": "linear",
        "keys": ["TEAM"],
        "project": "My Project",
        "close_on_merge": false,
        "merge_done": "Done",
        "token_env": "LINEAR_API_KEY"
      }
    },
    {
      "name": "my-github-repo",
      "path": "/absolute/path/to/another/repo",
      "branch_prefix": "yourusername/",
      "default_base": "main",
      "base_remote": "origin",
      "sidebar_color": "Green",
      "tickets": {
        "provider": "github",
        "dev_done": "ready for review",
        "start_label": "in progress",
        "close_on_merge": false
      }
    },
    {
      "name": "my-jira-repo",
      "path": "/absolute/path/to/a/third/repo",
      "branch_prefix": "yourusername/",
      "default_base": "main",
      "tickets": {
        "provider": "jira",
        "keys": ["PROJ"],
        "site_url": "https://yourteam.atlassian.net",
        "email": "you@example.com",
        "dev_done": "Dev Done",
        "merge_done": "Done",
        "close_on_merge": false,
        "token_env": "JIRA_API_TOKEN"
      }
    },
    {
      "name": "my-trello-repo",
      "path": "/absolute/path/to/a/fourth/repo",
      "branch_prefix": "yourusername/",
      "default_base": "main",
      "tickets": {
        "provider": "trello",
        "board": "Engineering",
        "dev_done": "Review",
        "merge_done": "Done",
        "close_on_merge": false,
        "key_env": "TRELLO_API_KEY",
        "token_env": "TRELLO_API_TOKEN"
      }
    },
    {
      "name": "scratch",
      "path": "/absolute/path/to/inplace/repo",
      "branch_prefix": "yourusername/",
      "default_base": "main",
      "use_worktree": false
    },
    {
      "name": "svc-auth",
      "path": "/absolute/path/to/acme/svc-auth",
      "org": "acme"
    },
    {
      "name": "svc-billing",
      "path": "/absolute/path/to/acme/svc-billing",
      "org": "acme"
    }
  ],
  "orgs": {
    "acme": {
      "sidebar_color": "Magenta",
      "branch_prefix": "yourusername/",
      "use_worktree": false,
      "tickets": {
        "provider": "github"
      }
    },
    "acme-labs": {
      "sidebar_color": "Cyan",
      "branch_prefix": "yourusername/",
      "tickets": {
        "provider": "linear",
        "keys": ["LABS"],
        "token_env": "LINEAR_API_KEY_ACME_LABS"
      }
    }
  },
  "slow_poll_interval_seconds": 300,
  "fast_poll_interval_seconds": 30,
  "autoclose_age_days": 14,
  "orphan_nudge_grace_hours": 4,
  "linear_state_ttl_seconds": 900,
  "linear_identity_ttl_seconds": 3600,
  "skills": {
    "session": "/session-coordination",
    "review": "/review",
    "plan": "/plan-pr",
    "actions": "/actions-pr"
  },
  "use_cship": false,
  "use_slack": false,
  "tool": "auto",
  "theme": "dark",
  "tui_theme": "textual-dark",
  "statusline_hide": ["cost", "session-time"]
}
